{
  "schemaVersion": 1,
  "hostVersion": "0.1.0",
  "runtimes": [
    {
      "id": "stt-runtime",
      "version": "1.0.0",
      "minHostVersion": "0.1.0",
      "minRuntimeVersion": "1.0.0",
      "installDir": "${data}/runtimes/stt-runtime",
      "type": "runtime",
      "entryExecutable": "runtime/lumina_backend.exe",
      "entryArguments": [
        "worker",
        "--capability",
        "stt"
      ],
      "healthEndpoint": "/health",
      "requiredFiles": [
        "manifest.json",
        "version.json",
        "hashes.json",
        "runtime/lumina_backend.exe"
      ],
      "resourceDirs": {},
      "platform": [
        "win32"
      ],
      "arch": [
        "x64"
      ],
      "autoStart": true,
      "optional": true,
      "displayName": "语音识别",
      "failureMode": "unavailable",
      "capabilities": [
        "stt"
      ],
      "sources": [
        {
          "name": "bundled",
          "root": "${resources}/runtimes/stt-runtime",
          "entryExecutable": "runtime/lumina_backend.exe",
          "entryArguments": [
            "worker",
            "--capability",
            "stt"
          ],
          "requiredFiles": [
            "manifest.json",
            "version.json",
            "hashes.json",
            "runtime/lumina_backend.exe"
          ]
        },
        {
          "name": "development",
          "root": "${project}/python_backend",
          "entryExecutable": "backend_launcher.py",
          "entryArguments": [
            "worker",
            "--capability",
            "stt"
          ],
          "requiredFiles": [
            "backend_launcher.py"
          ]
        }
      ]
    },
