{
  "schemaVersion": 1,
  "hostVersion": "0.1.0",
  "packages": [
    {
      "id": "core-runtime",
      "version": "1.0.0",
      "minHostVersion": "0.1.0",
      "minPackageVersion": "1.0.0",
      "installDir": "${data}/packages/core-runtime",
      "type": "runtime",
      "entryExecutable": "runtime/lumina_backend.exe",
      "entryArguments": [
        "core"
      ],
      "healthEndpoint": "/health",
      "requiredFiles": [
        "manifest.json",
        "version.json",
        "hashes.json"
      ],
      "resourceDirs": {},
      "platform": [
        "win32"
      ],
      "arch": [
        "x64"
      ],
      "autoStart": true,
      "optional": false,
      "displayName": "核心运行时",
      "failureMode": "block",
      "capabilities": [
        "core",
        "memory",
        "llm"
      ],
      "sources": [
        {
          "name": "bundled",
          "root": "${resources}/bin/lumina_backend",
          "entryExecutable": "lumina_backend.exe",
          "entryArguments": [
            "core"
          ],
          "requiredFiles": [
            "lumina_backend.exe"
          ]
        },
        {
          "name": "development",
          "root": "${project}/python_backend",
          "entryExecutable": "backend_launcher.py",
          "entryArguments": [
            "core"
          ],
          "requiredFiles": [
            "backend_launcher.py",
            "main.py"
          ]
        }
      ]
    },
    {
