{
  "name": "lumina",
  "private": true,
  "version": "0.1.0",
  "description": "AI Virtual Companion with Live2D and LLM integration",
  "author": "CheshireMew",
  "license": "GPL-3.0-or-later",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:backend": "python python_backend/packaging/build_all.py",
    "verify-runtimes": "python scripts/verify_worker_runtimes.py",
    "verify-runtime-contract": "python scripts/verify_worker_runtimes.py --contract-only",
    "verify-build": "python scripts/verify_build.py",
    "test": "vitest run --no-file-parallelism",
    "test:performance": "vitest run --no-file-parallelism app/renderer/companion/runtime/messageUpdateBatcher.test.ts app/renderer/core/voice/sentenceSplitter.test.ts app/renderer/core/voice/audioPlaybackPolicy.test.ts app/renderer/core/avatar/live2d/live2dPerformancePolicy.test.ts app/renderer/hooks/useRuntimeCapabilities.test.ts",
    "test:python": "python -m pytest -q -p no:cacheprovider",
    "gen-types": "powershell scripts/generate_api_client.ps1",
    "build": "npm run build:backend && npm run verify-runtimes && tsc && vite build && electron-builder",
    "preview": "vite preview",
    "lint": "eslint --config eslint.config.mjs \"app/**/*.{ts,tsx}\" \"core/**/*.{ts,tsx}\" \"vite.config.mts\""
  },
  "dependencies": {
    "axios": "^1.13.2",
    "electron-store": "^8.2.0",
    "eventemitter3": "^5.0.1",
    "lucide-react": "^0.562.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^4.0.17",
    "autoprefixer": "^10.4.17",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^10.2.0",
    "globals": "^17.4.0",
    "jsdom": "^27.4.0",
    "openapi-typescript": "^7.9.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^5.0.8",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.0.17"
  },
  "build": {
    "appId": "com.cheshiremew.lumina",
    "productName": "Lumina",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist/live2d/**/*",
      "!dist/libs/live2dcubismcore.min.js",
      "!dist/ort-*.wasm",
      "!dist/silero_vad*.onnx",
      "!dist/*vad*.js",
      "!dist/frame-processor.js",
      "!dist/resampler.js",
      "!dist/worklet.js",
      "!dist/default-model-fetcher.js",
      "!dist/asset-path.js",
      "!dist/messages.js",
      "!dist/logging.js",
      "!dist/bundle*.js",
      "!dist/utils.js",
      "!dist/index.js",
      "!python_backend/**/*",
      "!models/**/*",
      "!GPT-SoVITS/**/*",
      "!release/**/*",
      "!dist_backend/**/*",
      "!**/*.md",
      "!**/*.log"
    ],
    "directories": {
      "output": "release/${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "dist_backend/lumina_backend",
        "to": "bin/lumina_backend"
      },
      {
        "from": "dist_backend/runtimes/stt-runtime",
        "to": "runtimes/stt-runtime"
      },
      {
        "from": "dist_backend/runtimes/tts-runtime",
        "to": "runtimes/tts-runtime"
      },
      {
        "from": "dist_backend/runtimes/voiceprint-runtime",
        "to": "runtimes/voiceprint-runtime"
      },
      {
        "from": "dist_backend/runtimes/vision-runtime",
        "to": "runtimes/vision-runtime"
      },
      {
        "from": "config/ports.json",
        "to": "config/ports.json"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "LICENSING.md",
        "to": "LICENSING.md"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ]
  }
}
